<svg width="1600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="footerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#190a0a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0b0404;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1600" height="400" fill="url(#footerGrad)"/>
  <!-- Simple floral/botanical decorative element -->
  <g opacity="0.3">
    <circle cx="800" cy="200" r="80" fill="#f08b5a"/>
    <ellipse cx="750" cy="150" rx="40" ry="60" fill="#f6e8d0"/>
    <ellipse cx="850" cy="150" rx="40" ry="60" fill="#f6e8d0"/>
    <ellipse cx="750" cy="250" rx="40" ry="60" fill="#f6e8d0"/>
    <ellipse cx="850" cy="250" rx="40" ry="60" fill="#f6e8d0"/>
  </g>
  <text x="50%" y="50%" font-family="Arial" font-size="24" fill="#6c86a6" text-anchor="middle" dominant-baseline="middle">
    Footer Decorative Element - Replace with your floral image
  </text>
</svg>
